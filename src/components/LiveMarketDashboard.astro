---
/**
 * Phase 3GJ live market dashboard shell. Renders only the static tab controls and empty chart
 * containers at request time — every number (benchmark-proxy overview, treemap, scatter, sector and
 * breadth summary) is loaded client-side from /api/market/overview.json and /api/market/dashboard.json
 * after page load, and again only on an explicit tab click. No auto-refresh loop, no polling, no
 * fixture fallback: an unavailable/partial response renders an honest state, never a fabricated number.
 */
import { MARKET_TRACKED_UNIVERSES } from '../data/marketTrackedUniverses';
import { MARKET_DASHBOARD_PERIOD_IDS } from '../lib/market-dashboard/metrics';
import { PERIOD_LABELS } from '../lib/market-dashboard/formatters';
import MarketLiveQuoteCard from './MarketLiveQuoteCard.astro';

const isMarketQuoteCardEnabled = import.meta.env.KIS_ENABLE_MARKET_QUOTE_CARD === 'true';
const defaultUniverseId = MARKET_TRACKED_UNIVERSES[0].id;
const defaultPeriodId = MARKET_DASHBOARD_PERIOD_IDS[0];
const cameraPath =
  'M4 7.5h3l1.3-2h7.4l1.3 2h3a1.5 1.5 0 0 1 1.5 1.5v9A1.5 1.5 0 0 1 20 19.5H4A1.5 1.5 0 0 1 2.5 18V9A1.5 1.5 0 0 1 4 7.5Zm8 9a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0-1.8a2.2 2.2 0 1 1 0-4.4 2.2 2.2 0 0 1 0 4.4Z';
const expandPath = 'M4 9V4h5v2H7.4l3.1 3.1-1.4 1.4L6 7.4V9H4Zm11 0V7.4l-3.1 3.1-1.4-1.4L13.6 6H12V4h5v5h-2ZM4 15h2v1.6l3.1-3.1 1.4 1.4L7.4 18H9v2H4v-5Zm13 0v5h-5v-2h1.6l-3.1-3.1 1.4-1.4 3.1 3.1V15h2Z';
const returnScale = [
  { label: '-5% 이하', color: '#174ea6' },
  { label: '-3%', color: '#2563eb' },
  { label: '-1%', color: '#7aa5f8' },
  { label: '0%', color: '#9aa4b2' },
  { label: '+1%', color: '#f29a76' },
  { label: '+3%', color: '#d54a3f' },
  { label: '+5% 이상', color: '#9d1c22' },
];
---

<header class="page-header market-page-header">
  <div>
    <p class="eyebrow">Market</p>
    <h1>시장</h1>
    <p class="lead">
      KOSPI200·KOSDAQ150·S&amp;P500·NASDAQ100 대표 ETF와 실제 편입 종목의 최근 종가 기준 OHLCV로 계산한 시장 대시보드입니다.
      실시간 시세가 아닌 지연된 종가 기준이며, 지수 자체가 아닌 <strong>대표 ETF(proxy)</strong> 기준입니다.
      데이터를 불러올 수 없을 때는 있는 그대로 알려드립니다.
    </p>
  </div>
  <button type="button" class="market-refresh-button" data-market-refresh-button aria-live="polite">새로고침</button>
</header>

<MarketLiveQuoteCard enabled={isMarketQuoteCardEnabled} />

<section class="market-overview-row" data-market-overview aria-label="대표 벤치마크 개요">
  <p class="market-overview-loading" data-market-overview-loading role="status" aria-live="polite">대표 벤치마크 정보를 불러오는 중...</p>
  <div class="market-overview-grid hidden" data-market-overview-grid></div>
  <p class="market-overview-unavailable hidden" data-market-overview-unavailable role="status" aria-live="polite">
    대표 벤치마크 정보를 지금 불러올 수 없습니다.
  </p>
</section>

<section class="market-dashboard" data-market-dashboard data-active-universe={defaultUniverseId} data-active-period={defaultPeriodId}>
  <div class="market-control-panel" aria-label="시장 대시보드 선택">
    <div class="market-control-group">
      <span class="market-control-label">시장</span>
      <div class="market-tab-list" role="tablist" aria-label="시장 선택">
        {MARKET_TRACKED_UNIVERSES.map((universe, index) => (
          <button
            class:list={['market-tab-button', index === 0 && 'is-active']}
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            data-market-universe-tab={universe.id}
          >
            {universe.label}
          </button>
        ))}
      </div>
    </div>
    <div class="market-control-group">
      <span class="market-control-label">기간</span>
      <div class="market-tab-list compact" role="tablist" aria-label="기간 선택">
        {MARKET_DASHBOARD_PERIOD_IDS.map((periodId, index) => (
          <button
            class:list={['market-tab-button', index === 0 && 'is-active']}
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            data-market-period-tab={periodId}
          >
            {PERIOD_LABELS[periodId]}
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="market-dashboard-stage">
    <p class="market-dashboard-loading" data-market-dashboard-loading role="status" aria-live="polite">시장 데이터를 불러오는 중...</p>
    <div class="market-dashboard-unavailable hidden" data-market-dashboard-unavailable role="status" aria-live="polite">
      <p data-market-dashboard-unavailable-msg>시장 데이터를 지금 이용할 수 없습니다.</p>
    </div>

    <section class="market-dashboard-panel hidden" data-market-panel>
      <div class="market-summary-row">
        <div>
          <p class="eyebrow" data-market-panel-eyebrow>Live Dashboard</p>
          <h2 data-market-panel-title>—</h2>
        </div>
        <div class="market-summary-metrics" data-market-panel-metrics aria-label="시장 요약"></div>
      </div>

      <div class="market-dashboard-grid">
        <article class="market-chart-card market-treemap-card" id="marketLiveTreemapCard" data-exportable-card>
          <div class="market-card-header">
            <div>
              <h3>실데이터 Treemap</h3>
              <p>편입 종목의 비중(타일 크기)과 선택 기간 수익률(색상)을 보여줍니다.</p>
            </div>
            <div class="market-card-actions" data-card-actions>
              <button
                class="chart-export-button"
                type="button"
                data-expand-card
                data-expand-target="marketLiveTreemapCard"
                data-export-filename="mk-stock-lab-market-live-treemap"
                aria-label="크게 보기"
                title="크게 보기"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={expandPath} /></svg>
              </button>
              <button
                class="chart-export-button"
                type="button"
                data-export-card
                data-export-target="marketLiveTreemapCard"
                data-export-filename="mk-stock-lab-market-live-treemap"
                data-export-width="1200"
                aria-label="이미지로 저장"
                title="이미지로 저장"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={cameraPath} /></svg>
              </button>
            </div>
          </div>

          <svg class="market-treemap-svg" data-market-treemap-svg viewBox="0 0 1120 500" role="img" aria-label="실데이터 Treemap"></svg>

          <div class="market-return-scale" aria-label="수익률 색상 범례">
            <div class="market-return-ramp" aria-hidden="true">
              {returnScale.map((step) => <span style={`background:${step.color}`}></span>)}
            </div>
            <div class="market-return-labels">
              {returnScale.map((step) => <span>{step.label}</span>)}
            </div>
          </div>
        </article>

        <article class="market-chart-card market-scatter-card" id="marketLiveScatterCard" data-exportable-card>
          <div class="market-card-header">
            <div>
              <h3>Momentum / Trend</h3>
              <p>20일 모멘텀과 60일 이동평균 대비 위치를 비교합니다.</p>
            </div>
            <div class="market-card-actions" data-card-actions>
              <button
                class="chart-export-button"
                type="button"
                data-expand-card
                data-expand-target="marketLiveScatterCard"
                data-export-filename="mk-stock-lab-market-live-scatter"
                aria-label="크게 보기"
                title="크게 보기"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={expandPath} /></svg>
              </button>
              <button
                class="chart-export-button"
                type="button"
                data-export-card
                data-export-target="marketLiveScatterCard"
                data-export-filename="mk-stock-lab-market-live-scatter"
                data-export-width="800"
                aria-label="이미지로 저장"
                title="이미지로 저장"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={cameraPath} /></svg>
              </button>
            </div>
          </div>
          <svg class="market-scatter-chart" data-market-scatter-svg viewBox="0 0 720 460" role="img" aria-label="모멘텀 트렌드 산점도"></svg>
        </article>
      </div>

      <div class="market-breadth-summary" data-market-breadth aria-label="시장 폭 요약"></div>
    </section>
  </div>
</section>

<div class="market-card-modal hidden" id="marketCardModal" aria-hidden="true">
  <div class="market-card-modal-backdrop" data-close-expanded-card></div>
  <div class="market-card-modal-panel" role="dialog" aria-modal="true" aria-label="크게 보기">
    <div class="market-card-modal-actions" data-card-actions>
      <button class="chart-export-button" type="button" id="marketModalExportButton" aria-label="이미지로 저장" title="이미지로 저장">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={cameraPath} /></svg>
      </button>
      <button class="chart-export-button" type="button" data-close-expanded-card aria-label="닫기" title="닫기">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg>
      </button>
    </div>
    <div class="market-card-modal-content" id="marketCardModalContent" data-exportable-card></div>
  </div>
</div>

<script>
  import { exportCardAsPng, setupCardImageExport } from '../lib/exportCardImage';
  import { formatSignedPct, changeToneClass, colorForReturn, freshnessLabel, formatAsOfDate } from '../lib/market-dashboard/formatters';

  type OverviewProxy = {
    universeId: string;
    universeLabel: string;
    proxy: { symbol: string; country: string; label: string };
    status: 'ok' | 'unresolved' | 'unavailable' | 'insufficient-history';
    periodReturnPct: number | null;
    asOf: string | null;
    freshness: string;
  };

  type Constituent = {
    symbol: string;
    name: string;
    displayName?: string;
    sector: string;
    relativeWeight: number;
    status: 'ok' | 'unresolved' | 'unavailable' | 'insufficient-history';
    periodReturnPct: number | null;
    momentum20dPct: number | null;
    trendVsSma60Pct: number | null;
    asOf: string | null;
  };

  type DashboardPayload = {
    universeId: string;
    period: string;
    currency: string;
    benchmarkProxy: { symbol: string; country: string; label: string };
    constituents: Constituent[];
    sectors: Array<{ sector: string; successfulCount: number; weightedPeriodReturnPct: number | null; advancers: number; decliners: number }>;
    breadth: {
      requestedCount: number;
      successfulCount: number;
      advancers: number;
      decliners: number;
      unchanged: number;
      weightedPeriodReturnPct: number | null;
      strongestSector: string | null;
      weakestSector: string | null;
      commonAsOf: string | null;
    } | null;
    freshness: string;
  };

  const svgNs = 'http://www.w3.org/2000/svg';
  const clamp = (value: number, min: number, max: number) => Math.max(min, Math.min(max, value));
  const el = <K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string> = {}) => {
    const node = document.createElementNS(svgNs, tag);
    Object.entries(attrs).forEach(([key, value]) => node.setAttribute(key, value));
    return node;
  };

  // Phase 3GJ-HF1 spec section 10: browser-memory-only (no localStorage) cache with a >=60s TTL, plus
  // in-flight request deduplication so overlapping loads for the same key share one network request.
  const CACHE_TTL_MS = 60_000;
  type CachedFetch = { ok: boolean; body: any };
  const responseCache = new Map<string, { data: CachedFetch; timestamp: number }>();
  const inFlightRequests = new Map<string, Promise<CachedFetch>>();

  const fetchJsonCached = async (key: string, url: string, forceRefresh: boolean): Promise<CachedFetch> => {
    const now = Date.now();
    if (!forceRefresh) {
      const cached = responseCache.get(key);
      if (cached && now - cached.timestamp < CACHE_TTL_MS) return cached.data;
      const pending = inFlightRequests.get(key);
      if (pending) return pending;
    }
    const request = (async (): Promise<CachedFetch> => {
      const res = await fetch(url);
      const body = await res.json();
      const result: CachedFetch = { ok: res.ok, body };
      responseCache.set(key, { data: result, timestamp: Date.now() });
      return result;
    })();
    inFlightRequests.set(key, request);
    try {
      return await request;
    } finally {
      inFlightRequests.delete(key);
    }
  };

  const setup = () => {
    const overviewRoot = document.querySelector<HTMLElement>('[data-market-overview]');
    const dashboardRoot = document.querySelector<HTMLElement>('[data-market-dashboard]');
    if (!dashboardRoot || dashboardRoot.dataset.liveReady === 'true') return;
    dashboardRoot.dataset.liveReady = 'true';

    const overviewLoading = overviewRoot?.querySelector<HTMLElement>('[data-market-overview-loading]');
    const overviewGrid = overviewRoot?.querySelector<HTMLElement>('[data-market-overview-grid]');
    const overviewUnavailable = overviewRoot?.querySelector<HTMLElement>('[data-market-overview-unavailable]');

    const loadOverview = async (forceRefresh = false) => {
      try {
        const { ok, body } = await fetchJsonCached('overview:1d', '/api/market/overview.json?period=1d', forceRefresh);
        if (!ok || body?.ok !== true || !Array.isArray(body?.overview?.proxies)) {
          overviewLoading?.classList.add('hidden');
          overviewUnavailable?.classList.remove('hidden');
          return;
        }
        const proxies: OverviewProxy[] = body.overview.proxies;
        if (overviewGrid) {
          overviewGrid.innerHTML = proxies
            .map((proxy) => {
              if (proxy.status !== 'ok') {
                return `<div class="market-overview-card market-overview-card--unavailable">
  <p class="market-overview-card-label">${proxy.universeLabel}</p>
  <p class="market-overview-card-proxy">${proxy.proxy.label}</p>
  <p class="market-overview-card-value">이용 불가</p>
</div>`;
              }
              const tone = changeToneClass(proxy.periodReturnPct);
              return `<div class="market-overview-card">
  <p class="market-overview-card-label">${proxy.universeLabel}</p>
  <p class="market-overview-card-proxy">${proxy.proxy.label}</p>
  <p class="market-overview-card-value ${tone}">${formatSignedPct(proxy.periodReturnPct)}</p>
  <div class="market-overview-card-meta">
    <span class="market-freshness-badge market-freshness-badge--${proxy.freshness}">${freshnessLabel(proxy.freshness)}</span>
    <span>${formatAsOfDate(proxy.asOf)}</span>
  </div>
</div>`;
            })
            .join('');
        }
        overviewLoading?.classList.add('hidden');
        overviewGrid?.classList.remove('hidden');
      } catch {
        overviewLoading?.classList.add('hidden');
        overviewUnavailable?.classList.remove('hidden');
      }
    };

    const dashboardLoading = dashboardRoot.querySelector<HTMLElement>('[data-market-dashboard-loading]');
    const dashboardUnavailable = dashboardRoot.querySelector<HTMLElement>('[data-market-dashboard-unavailable]');
    const dashboardUnavailableMsg = dashboardRoot.querySelector<HTMLElement>('[data-market-dashboard-unavailable-msg]');
    const panel = dashboardRoot.querySelector<HTMLElement>('[data-market-panel]');
    const panelEyebrow = dashboardRoot.querySelector<HTMLElement>('[data-market-panel-eyebrow]');
    const panelTitle = dashboardRoot.querySelector<HTMLElement>('[data-market-panel-title]');
    const panelMetrics = dashboardRoot.querySelector<HTMLElement>('[data-market-panel-metrics]');
    const treemapSvg = dashboardRoot.querySelector<SVGSVGElement>('[data-market-treemap-svg]');
    const scatterSvg = dashboardRoot.querySelector<SVGSVGElement>('[data-market-scatter-svg]');
    const breadthEl = dashboardRoot.querySelector<HTMLElement>('[data-market-breadth]');
    const universeTabs = Array.from(dashboardRoot.querySelectorAll<HTMLButtonElement>('[data-market-universe-tab]'));
    const periodTabs = Array.from(dashboardRoot.querySelectorAll<HTMLButtonElement>('[data-market-period-tab]'));

    const treemapWidth = 1120;
    const treemapHeight = 500;
    const scatterWidth = 720;
    const scatterHeight = 460;
    const plot = { x: 58, y: 46, width: 618, height: 350 };

    const renderTreemap = async (constituents: Constituent[], currency: string) => {
      if (!treemapSvg) return;
      treemapSvg.innerHTML = '';
      treemapSvg.appendChild(el('rect', { x: '0', y: '0', width: String(treemapWidth), height: String(treemapHeight), rx: '14', fill: '#f8fafc' }));

      const ok = constituents.filter((item) => item.status === 'ok' && item.relativeWeight > 0);
      if (ok.length === 0) return;

      const { hierarchy, treemap, treemapSquarify } = await import('d3-hierarchy');
      const sectorMap = new Map<string, Constituent[]>();
      ok.forEach((item) => {
        const list = sectorMap.get(item.sector) ?? [];
        list.push(item);
        sectorMap.set(item.sector, list);
      });
      const sectors = [...sectorMap.entries()]
        .map(([label, items]) => ({ label, items: items.sort((a, b) => b.relativeWeight - a.relativeWeight) }))
        .sort((a, b) => b.items.reduce((s, i) => s + i.relativeWeight, 0) - a.items.reduce((s, i) => s + i.relativeWeight, 0));

      const root = hierarchy({
        name: 'Market',
        children: sectors.map((sector) => ({
          name: sector.label,
          children: sector.items.map((item) => ({ name: item.displayName || item.name, value: item.relativeWeight, item })),
        })),
      })
        .sum((d: any) => d.value ?? 0)
        .sort((a: any, b: any) => (b.value ?? 0) - (a.value ?? 0));

      treemap()
        .tile(treemapSquarify.ratio(1.18))
        .size([treemapWidth, treemapHeight])
        .round(true)
        .paddingOuter(4)
        .paddingInner(3)
        .paddingTop((node: any) => (node.depth === 1 ? 22 : 0))(root as any);

      (root.children ?? []).forEach((sectorNode: any) => {
        const sx = sectorNode.x0;
        const sy = sectorNode.y0;
        const sw = Math.max(0, sectorNode.x1 - sectorNode.x0);
        const sh = Math.max(0, sectorNode.y1 - sectorNode.y0);
        const g = el('g');
        g.appendChild(el('rect', { x: String(sx), y: String(sy), width: String(sw), height: String(sh), rx: '10', fill: '#edf2f7', stroke: '#cbd5e1', 'stroke-width': '1.5' }));
        if (sw > 112 && sh > 58) {
          const label = el('text', { x: String(sx + 10), y: String(sy + 18), class: 'market-treemap-sector-label' });
          label.textContent = sectorNode.data.name;
          g.appendChild(label);
        }
        sectorNode.leaves().forEach((leaf: any) => {
          const item: Constituent = leaf.data.item;
          const lx = leaf.x0;
          const ly = leaf.y0;
          const lw = Math.max(0, leaf.x1 - leaf.x0);
          const lh = Math.max(0, leaf.y1 - leaf.y0);
          const tileGroup = el('g');
          const title = el('title');
          title.textContent = `${item.displayName || item.name} (${item.symbol}) ${formatSignedPct(item.periodReturnPct)}`;
          tileGroup.appendChild(title);
          tileGroup.appendChild(el('rect', {
            x: String(lx), y: String(ly), width: String(lw), height: String(lh), rx: '5',
            fill: colorForReturn(item.periodReturnPct), stroke: '#ffffff', 'stroke-width': '1.4',
          }));
          if (lw > 76 && lh > 42) {
            const nameText = el('text', { x: String(lx + 8), y: String(ly + 18), class: 'market-treemap-symbol' });
            nameText.textContent = item.displayName || item.name;
            const changeText = el('text', { x: String(lx + 8), y: String(ly + 37), class: 'market-treemap-change' });
            changeText.textContent = formatSignedPct(item.periodReturnPct);
            tileGroup.appendChild(nameText);
            tileGroup.appendChild(changeText);
          } else if (lw > 54 && lh > 28) {
            const nameText = el('text', { x: String(lx + 7), y: String(ly + 18), class: 'market-treemap-symbol compact' });
            nameText.textContent = item.displayName || item.name;
            tileGroup.appendChild(nameText);
          }
          g.appendChild(tileGroup);
        });
        treemapSvg.appendChild(g);
      });
      void currency;
    };

    const renderScatter = (constituents: Constituent[]) => {
      if (!scatterSvg) return;
      scatterSvg.innerHTML = '';
      scatterSvg.appendChild(el('rect', { x: '0', y: '0', width: String(scatterWidth), height: String(scatterHeight), rx: '16', fill: '#ffffff' }));
      scatterSvg.appendChild(el('rect', { x: String(plot.x), y: String(plot.y), width: String(plot.width), height: String(plot.height), rx: '10', fill: '#f8fafc', stroke: '#d8e2ee' }));
      scatterSvg.appendChild(el('line', { x1: String(plot.x + plot.width / 2), y1: String(plot.y), x2: String(plot.x + plot.width / 2), y2: String(plot.y + plot.height), stroke: '#aeb8c6', 'stroke-width': '1' }));
      scatterSvg.appendChild(el('line', { x1: String(plot.x), y1: String(plot.y + plot.height / 2), x2: String(plot.x + plot.width), y2: String(plot.y + plot.height / 2), stroke: '#aeb8c6', 'stroke-width': '1' }));
      const momentumLabel = el('text', { x: String(plot.x), y: String(plot.y - 22), class: 'scatter-axis-label' });
      momentumLabel.textContent = '20일 모멘텀';
      const trendLabel = el('text', { x: String(plot.x + plot.width), y: String(plot.y + plot.height + 30), 'text-anchor': 'end', class: 'scatter-axis-label' });
      trendLabel.textContent = '60일 트렌드';
      scatterSvg.appendChild(momentumLabel);
      scatterSvg.appendChild(trendLabel);

      constituents
        .filter((item) => item.status === 'ok' && item.momentum20dPct !== null && item.trendVsSma60Pct !== null)
        .forEach((item, index) => {
          const trend = clamp(item.trendVsSma60Pct as number, -10, 10);
          const momentum = clamp(item.momentum20dPct as number, -10, 10);
          const x = clamp(plot.x + ((trend + 10) / 20) * plot.width, plot.x + 10, plot.x + plot.width - 10);
          const y = clamp(plot.y + ((10 - momentum) / 20) * plot.height, plot.y + 10, plot.y + plot.height - 10);
          const g = el('g', { class: 'scatter-point', transform: `translate(${x} ${y})` });
          const title = el('title');
          title.textContent = `${item.displayName || item.name} (${item.symbol}) · Momentum ${(item.momentum20dPct as number).toFixed(1)} · Trend ${(item.trendVsSma60Pct as number).toFixed(1)}`;
          g.appendChild(title);
          g.appendChild(el('circle', { r: '7.5', fill: colorForReturn(item.periodReturnPct), stroke: '#ffffff', 'stroke-width': '2' }));
          if (item.relativeWeight >= 100 || index < 8) {
            const labelLeft = index % 4 === 2;
            const labelAbove = index % 3 === 1;
            const labelText = el('text', {
              x: String(labelLeft ? -12 : 12),
              y: String(labelAbove ? -10 : 5),
              'text-anchor': labelLeft ? 'end' : 'start',
            });
            labelText.textContent = item.displayName || item.name;
            g.appendChild(labelText);
          }
          scatterSvg.appendChild(g);
        });
    };

    const renderBreadth = (dashboard: DashboardPayload) => {
      if (!breadthEl) return;
      if (!dashboard.breadth) {
        breadthEl.innerHTML = '';
        return;
      }
      const b = dashboard.breadth;
      const coverage = `${b.successfulCount}/${b.requestedCount}`;
      breadthEl.innerHTML = `
        <span class="market-freshness-badge market-freshness-badge--${dashboard.freshness}">${freshnessLabel(dashboard.freshness)}</span>
        <span>커버리지 ${coverage}</span>
        <span>상승 ${b.advancers} · 하락 ${b.decliners} · 보합 ${b.unchanged}</span>
        <span>가중평균 ${formatSignedPct(b.weightedPeriodReturnPct)}</span>
        ${b.strongestSector ? `<span>강세 ${b.strongestSector}</span>` : ''}
        ${b.weakestSector ? `<span>약세 ${b.weakestSector}</span>` : ''}
        <span>${formatAsOfDate(b.commonAsOf)}</span>
      `;
    };

    const universeLabelOf = (id: string) => universeTabs.find((tab) => tab.dataset.marketUniverseTab === id)?.textContent?.trim() ?? id;
    const periodLabelOf = (id: string) => periodTabs.find((tab) => tab.dataset.marketPeriodTab === id)?.textContent?.trim() ?? id;

    let requestToken = 0;
    const loadDashboard = async (universeId: string, period: string, forceRefresh = false) => {
      const token = ++requestToken;
      dashboardRoot.dataset.activeUniverse = universeId;
      dashboardRoot.dataset.activePeriod = period;
      dashboardLoading?.classList.remove('hidden');
      dashboardUnavailable?.classList.add('hidden');
      panel?.classList.add('hidden');

      try {
        const cacheKey = `dashboard:${universeId}:${period}`;
        const url = `/api/market/dashboard.json?universe=${encodeURIComponent(universeId)}&period=${encodeURIComponent(period)}`;
        const { ok, body } = await fetchJsonCached(cacheKey, url, forceRefresh);
        if (token !== requestToken) return;

        if (!ok || body?.ok !== true || !body?.dashboard) {
          dashboardLoading?.classList.add('hidden');
          if (dashboardUnavailableMsg) {
            dashboardUnavailableMsg.textContent =
              body?.code === 'MARKET_DATA_PARTIAL_BELOW_THRESHOLD'
                ? '유효한 종목 데이터가 부족해 지금은 표시할 수 없습니다.'
                : '시장 데이터를 지금 이용할 수 없습니다.';
          }
          dashboardUnavailable?.classList.remove('hidden');
          return;
        }

        const dashboard: DashboardPayload = body.dashboard;
        if (panelEyebrow) panelEyebrow.textContent = 'Live Dashboard';
        if (panelTitle) panelTitle.textContent = `${universeLabelOf(universeId)} · ${periodLabelOf(period)} (${dashboard.benchmarkProxy.label})`;
        if (panelMetrics && dashboard.breadth) {
          panelMetrics.innerHTML = `<span><strong>${dashboard.breadth.advancers}</strong> 상승</span><span><strong>${dashboard.breadth.decliners}</strong> 하락</span><span>${formatAsOfDate(dashboard.breadth.commonAsOf)}</span>`;
        }

        await renderTreemap(dashboard.constituents, dashboard.currency);
        renderScatter(dashboard.constituents);
        renderBreadth(dashboard);

        dashboardLoading?.classList.add('hidden');
        panel?.classList.remove('hidden');
      } catch {
        if (token !== requestToken) return;
        dashboardLoading?.classList.add('hidden');
        if (dashboardUnavailableMsg) dashboardUnavailableMsg.textContent = '시장 데이터를 지금 이용할 수 없습니다.';
        dashboardUnavailable?.classList.remove('hidden');
      }
    };

    universeTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const universeId = tab.dataset.marketUniverseTab;
        const period = dashboardRoot.dataset.activePeriod || periodTabs[0]?.dataset.marketPeriodTab;
        if (!universeId || !period) return;
        universeTabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        loadDashboard(universeId, period);
      });
    });

    periodTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const period = tab.dataset.marketPeriodTab;
        const universeId = dashboardRoot.dataset.activeUniverse || universeTabs[0]?.dataset.marketUniverseTab;
        if (!period || !universeId) return;
        periodTabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        loadDashboard(universeId, period);
      });
    });

    // Phase 3GJ-HF1 spec section 11: sequence the initial loads instead of firing them concurrently.
    void (async () => {
      await loadOverview();
      await loadDashboard(dashboardRoot.dataset.activeUniverse || 'kospi200', dashboardRoot.dataset.activePeriod || '1d');
    })();

    // Phase 3GJ-HF1 spec section 12: one explicit refresh control with a >=30s cooldown. No
    // cache-bypass query params are sent -- the client simply re-requests past its own memory cache.
    const REFRESH_COOLDOWN_MS = 30_000;
    const refreshButton = document.querySelector<HTMLButtonElement>('[data-market-refresh-button]');
    let lastRefreshAt = 0;
    let cooldownTimer: number | undefined;

    const updateRefreshButtonState = () => {
      if (!refreshButton) return;
      const remainingMs = REFRESH_COOLDOWN_MS - (Date.now() - lastRefreshAt);
      if (remainingMs > 0) {
        refreshButton.disabled = true;
        refreshButton.textContent = `새로고침 (${Math.ceil(remainingMs / 1000)}초 후 가능)`;
      } else {
        refreshButton.disabled = false;
        refreshButton.textContent = '새로고침';
        if (cooldownTimer !== undefined) {
          window.clearInterval(cooldownTimer);
          cooldownTimer = undefined;
        }
      }
    };

    refreshButton?.addEventListener('click', () => {
      if (Date.now() - lastRefreshAt < REFRESH_COOLDOWN_MS) return;
      lastRefreshAt = Date.now();
      updateRefreshButtonState();
      if (cooldownTimer === undefined) {
        cooldownTimer = window.setInterval(updateRefreshButtonState, 1000);
      }
      const universeId = dashboardRoot.dataset.activeUniverse || universeTabs[0]?.dataset.marketUniverseTab || 'kospi200';
      const period = dashboardRoot.dataset.activePeriod || periodTabs[0]?.dataset.marketPeriodTab || '1d';
      void (async () => {
        await loadOverview(true);
        await loadDashboard(universeId, period, true);
      })();
    });
  };

  const setupMarketCardModal = () => {
    const modal = document.getElementById('marketCardModal');
    const content = document.getElementById('marketCardModalContent');
    const exportButton = document.getElementById('marketModalExportButton') as HTMLButtonElement | null;
    if (!modal || !content || modal.dataset.ready === 'true') return;
    modal.dataset.ready = 'true';

    let currentFilename = 'mk-stock-lab-market-card';

    const close = () => {
      modal.classList.add('hidden');
      modal.setAttribute('aria-hidden', 'true');
      content.replaceChildren();
      document.body.classList.remove('modal-open');
    };

    const open = (card: HTMLElement, filename: string) => {
      const clone = card.cloneNode(true) as HTMLElement;
      clone.removeAttribute('id');
      clone.querySelectorAll('[data-card-actions]').forEach((node) => node.remove());
      content.replaceChildren(clone);
      currentFilename = filename;
      modal.classList.remove('hidden');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('modal-open');
    };

    document.querySelectorAll<HTMLButtonElement>('[data-expand-card]').forEach((button) => {
      if (button.dataset.expandReady === 'true') return;
      button.dataset.expandReady = 'true';
      button.addEventListener('click', () => {
        const targetId = button.dataset.expandTarget;
        const target = targetId ? document.getElementById(targetId) : null;
        if (!target) return;
        open(target, button.dataset.exportFilename || targetId || 'mk-stock-lab-market-card');
      });
    });

    document.querySelectorAll<HTMLElement>('[data-close-expanded-card]').forEach((closeTarget) => {
      if (closeTarget.dataset.closeReady === 'true') return;
      closeTarget.dataset.closeReady = 'true';
      closeTarget.addEventListener('click', close);
    });

    exportButton?.addEventListener('click', async () => {
      const target = content.querySelector<HTMLElement>('.market-chart-card');
      if (!target) return;
      exportButton.disabled = true;
      try {
        await exportCardAsPng(target, currentFilename);
      } catch {
        window.alert('이미지 저장을 완료하지 못했습니다. Chrome에서 다시 시도해 주세요.');
      } finally {
        exportButton.disabled = false;
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.classList.contains('hidden')) close();
    });
  };

  document.addEventListener('astro:page-load', () => {
    setupCardImageExport();
    setup();
    setupMarketCardModal();
  });
  setupCardImageExport();
  setup();
  setupMarketCardModal();
</script>
