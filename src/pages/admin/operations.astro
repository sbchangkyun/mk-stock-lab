---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="운영 현황 | MK Stock Lab" activePath="/admin/operations">
  <header class="page-header">
    <div>
      <p class="eyebrow">내부 운영 현황</p>
      <h1>Operations Overview</h1>
      <p class="lead">Chart AI 사용량 가드, KIS 토큰 상태, 시세 캐시 상태를 한 화면에서 확인합니다. 읽기 전용이며 어떤 값도 변경하거나 초기화하지 않습니다.</p>
    </div>
  </header>

  <div class="admin-ops-loading-state" id="admin-ops-checking" data-state="checking">
    <p>로그인 상태를 확인하는 중입니다.</p>
  </div>

  <section class="admin-ops-lock-state hidden" id="admin-ops-lock-state" aria-live="polite">
    <div class="lock-visual" aria-hidden="true">🔐</div>
    <div>
      <p class="eyebrow">접속 필요</p>
      <h2 id="admin-ops-lock-title">로그인이 필요합니다</h2>
      <p id="admin-ops-lock-copy">이 화면은 관리자만 볼 수 있습니다.</p>
    </div>
    <button class="primary-action" id="admin-ops-login-action" type="button" hidden>회원가입 / 로그인</button>
  </section>

  <section class="admin-ops-body hidden" id="admin-ops-body">
    <div class="admin-ops-toolbar">
      <p class="admin-ops-refreshed" id="admin-ops-refreshed">마지막 �-신: -</p>
      <button class="secondary-action" id="admin-ops-refresh" type="button">새로고침</button>
    </div>
    <p class="admin-ops-notice hidden" id="admin-ops-stale-notice" role="status" aria-live="polite"></p>

    <section class="admin-ops-card" id="admin-ops-usage-card">
      <h2>Usage Guard (Chart AI 일일 사용량)</h2>
      <dl class="admin-ops-kv" id="admin-ops-usage-kv"></dl>
    </section>

    <section class="admin-ops-card" id="admin-ops-kis-card">
      <h2>KIS Token Health</h2>
      <dl class="admin-ops-kv" id="admin-ops-kis-kv"></dl>
    </section>

    <section class="admin-ops-card" id="admin-ops-caches-card">
      <h2>Quote Cache Health</h2>
      <div id="admin-ops-caches-list"></div>
    </section>
  </section>

  <style>
    .admin-ops-loading-state,
    .admin-ops-lock-state {
      padding: 2rem 1rem;
      text-align: center;
    }
    .admin-ops-lock-state .lock-visual {
      font-size: 2rem;
    }
    .admin-ops-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      margin-bottom: 1rem;
    }
    .admin-ops-refreshed {
      font-size: 0.85rem;
      opacity: 0.75;
    }
    .admin-ops-notice {
      font-size: 0.85rem;
      padding: 0.5rem 0.75rem;
      border-radius: 8px;
      background: rgba(255, 196, 0, 0.12);
      margin-bottom: 1rem;
    }
    .admin-ops-card {
      border: 1px solid var(--border-color, rgba(128, 128, 128, 0.25));
      border-radius: 12px;
      padding: 1rem 1.25rem;
      margin-bottom: 1rem;
    }
    .admin-ops-card h2 {
      margin: 0 0 0.75rem 0;
      font-size: 1.05rem;
    }
    .admin-ops-kv {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0.4rem 1rem;
      margin: 0;
    }
    .admin-ops-kv dt {
      opacity: 0.7;
      font-size: 0.85rem;
    }
    .admin-ops-kv dd {
      margin: 0;
      font-size: 0.9rem;
      word-break: break-word;
    }
    .admin-ops-status-healthy { color: #1a9b4c; font-weight: 600; }
    .admin-ops-status-warning { color: #b8860b; font-weight: 600; }
    .admin-ops-status-unavailable { color: #888; font-weight: 600; }
    .admin-ops-cache-item {
      border-top: 1px solid var(--border-color, rgba(128, 128, 128, 0.15));
      padding-top: 0.75rem;
      margin-top: 0.75rem;
    }
    .admin-ops-cache-item:first-child {
      border-top: none;
      padding-top: 0;
      margin-top: 0;
    }
    .hidden { display: none !important; }
  </style>

  <script>
    import { getBrowserSupabaseClient, isSupabaseConfigured } from '../../lib/supabase';

    type OperationsHealthStatus = 'healthy' | 'warning' | 'unavailable';

    type UsageGuardOverview = {
      status: OperationsHealthStatus;
      storeReady: boolean;
      usageDateKst: string | null;
      configuredDailyLimit: number;
      totalGuardedExecutionsToday: number;
      distinctUserCountToday: number;
      usersAtLimitCountToday: number;
      mostRecentGuardedExecutionAtIso: string | null;
      sanitizedErrorCode: string | null;
    };

    type KisTokenOverview = {
      status: OperationsHealthStatus;
      kisConfigReady: boolean;
      durableStoreReady: boolean;
      durableMisconfigured: boolean;
      l1TokenPresent: boolean;
      l2TokenPresent: boolean;
      tokenExpiresAtIso: string | null;
      remainingLifetimeSeconds: number | null;
      staleOrExpired: boolean;
      lastIssueOrReuseAtIso: string | null;
      sanitizedErrorCode: string | null;
    };

    type QuoteCacheSummary = {
      cacheId: string;
      scope: string;
      durability: 'instance-local';
      entryCount: number;
      configuredTtlMs: number | null;
      newestEntryAgeMs: number | null;
      oldestEntryAgeMs: number | null;
      freshCount: number | null;
      staleCount: number | null;
      expiredCount: number | null;
      lastSuccessfulUpdateAtIso: string | null;
      status: OperationsHealthStatus;
    };

    type AdminOperationsOverview = {
      generatedAtIso: string;
      usageGuard: UsageGuardOverview;
      kisToken: KisTokenOverview;
      quoteCaches: QuoteCacheSummary[];
    };

    const checkingEl = document.getElementById('admin-ops-checking');
    const lockEl = document.getElementById('admin-ops-lock-state');
    const lockTitleEl = document.getElementById('admin-ops-lock-title');
    const lockCopyEl = document.getElementById('admin-ops-lock-copy');
    const loginActionEl = document.getElementById('admin-ops-login-action');
    const bodyEl = document.getElementById('admin-ops-body');
    const refreshedEl = document.getElementById('admin-ops-refreshed');
    const refreshBtn = document.getElementById('admin-ops-refresh') as HTMLButtonElement | null;
    const staleNoticeEl = document.getElementById('admin-ops-stale-notice');
    const usageKvEl = document.getElementById('admin-ops-usage-kv');
    const kisKvEl = document.getElementById('admin-ops-kis-kv');
    const cachesListEl = document.getElementById('admin-ops-caches-list');

    let lastGoodOverview: AdminOperationsOverview | null = null;
    let refreshInFlight = false;

    const showOnly = (el: Element | null) => {
      [checkingEl, lockEl, bodyEl].forEach((node) => node?.classList.add('hidden'));
      el?.classList.remove('hidden');
    };

    const statusLabel = (status: OperationsHealthStatus) =>
      status === 'healthy' ? '정상' : status === 'warning' ? '주의' : '정보 없음';

    const statusClass = (status: OperationsHealthStatus) => `admin-ops-status-${status}`;

    const fmtBool = (value: boolean) => (value ? '예' : '아니오');
    const fmtMs = (value: number | null) => (value === null ? '-' : `${Math.round(value / 1000)}초`);
    const fmtIso = (value: string | null) => (value === null ? '없음' : new Date(value).toLocaleString('ko-KR'));
    const fmtNum = (value: number | null) => (value === null ? '-' : String(value));

    const kv = (parent: HTMLElement, label: string, value: string) => {
      const dt = document.createElement('dt');
      dt.textContent = label;
      const dd = document.createElement('dd');
      dd.textContent = value;
      parent.appendChild(dt);
      parent.appendChild(dd);
    };

    const kvStatus = (parent: HTMLElement, label: string, status: OperationsHealthStatus) => {
      const dt = document.createElement('dt');
      dt.textContent = label;
      const dd = document.createElement('dd');
      dd.textContent = statusLabel(status);
      dd.className = statusClass(status);
      parent.appendChild(dt);
      parent.appendChild(dd);
    };

    const renderOverview = (overview: AdminOperationsOverview) => {
      if (!usageKvEl || !kisKvEl || !cachesListEl || !refreshedEl) return;

      usageKvEl.innerHTML = '';
      kvStatus(usageKvEl as HTMLElement, '상태', overview.usageGuard.status);
      kv(usageKvEl as HTMLElement, '기준 날짜 (KST)', overview.usageGuard.usageDateKst ?? '없음');
      kv(usageKvEl as HTMLElement, '일일 한도', String(overview.usageGuard.configuredDailyLimit));
      kv(usageKvEl as HTMLElement, '오늘 총 사용 횟수', String(overview.usageGuard.totalGuardedExecutionsToday));
      kv(usageKvEl as HTMLElement, '오늘 이용자 수(익명 집계)', String(overview.usageGuard.distinctUserCountToday));
      kv(usageKvEl as HTMLElement, '한도 도달 이용자 수(익명 집계)', String(overview.usageGuard.usersAtLimitCountToday));
      kv(usageKvEl as HTMLElement, '가장 최근 사용 시각', fmtIso(overview.usageGuard.mostRecentGuardedExecutionAtIso));
      kv(usageKvEl as HTMLElement, '저장소 준비 상태', fmtBool(overview.usageGuard.storeReady));

      kisKvEl.innerHTML = '';
      kvStatus(kisKvEl as HTMLElement, '상태', overview.kisToken.status);
      kv(kisKvEl as HTMLElement, 'KIS 설정 준비', fmtBool(overview.kisToken.kisConfigReady));
      kv(kisKvEl as HTMLElement, '내구성 저장소(L2) 준비', fmtBool(overview.kisToken.durableStoreReady));
      kv(kisKvEl as HTMLElement, '메모리(L1) 토큰 존재', fmtBool(overview.kisToken.l1TokenPresent));
      kv(kisKvEl as HTMLElement, '내구성 저장소(L2) 토큰 존재', fmtBool(overview.kisToken.l2TokenPresent));
      kv(kisKvEl as HTMLElement, '토큰 만료 시각', fmtIso(overview.kisToken.tokenExpiresAtIso));
      kv(kisKvEl as HTMLElement, '남은 유효 시간', fmtMs(overview.kisToken.remainingLifetimeSeconds === null ? null : overview.kisToken.remainingLifetimeSeconds * 1000));
      kv(kisKvEl as HTMLElement, '만료/오래됨 여부', fmtBool(overview.kisToken.staleOrExpired));
      kv(kisKvEl as HTMLElement, '최근 발급/재사용 시각', fmtIso(overview.kisToken.lastIssueOrReuseAtIso));

      cachesListEl.innerHTML = '';
      overview.quoteCaches.forEach((cache) => {
        const item = document.createElement('div');
        item.className = 'admin-ops-cache-item';
        const heading = document.createElement('h3');
        heading.textContent = `${cache.scope} (인스턴스 로컬)`;
        item.appendChild(heading);
        const dl = document.createElement('dl');
        dl.className = 'admin-ops-kv';
        kvStatus(dl, '상태', cache.status);
        kv(dl, '캐시 항목 수', fmtNum(cache.entryCount));
        kv(dl, '신선(fresh) 항목', fmtNum(cache.freshCount));
        kv(dl, '오래된(stale) 항목', fmtNum(cache.staleCount));
        kv(dl, '만료(expired) 항목', fmtNum(cache.expiredCount));
        kv(dl, '가장 최근 항목 나이', fmtMs(cache.newestEntryAgeMs));
        kv(dl, '가장 오래된 항목 나이', fmtMs(cache.oldestEntryAgeMs));
        kv(dl, '마지막 갱신 시각', fmtIso(cache.lastSuccessfulUpdateAtIso));
        item.appendChild(dl);
        cachesListEl.appendChild(item);
      });

      refreshedEl.textContent = `마지막 갱신: ${new Date(overview.generatedAtIso).toLocaleString('ko-KR')}`;
    };

    const setStaleNotice = (message: string | null) => {
      if (!staleNoticeEl) return;
      if (!message) {
        staleNoticeEl.classList.add('hidden');
        staleNoticeEl.textContent = '';
        return;
      }
      staleNoticeEl.textContent = message;
      staleNoticeEl.classList.remove('hidden');
    };

    const loadOverview = async () => {
      if (refreshInFlight) return; // never overlap requests
      refreshInFlight = true;
      if (refreshBtn) refreshBtn.disabled = true;

      try {
        const client = getBrowserSupabaseClient();
        const { data: sessionData } = client ? await client.auth.getSession() : { data: { session: null } };
        const accessToken = sessionData.session?.access_token;
        if (!accessToken) {
          showOnly(lockEl);
          return;
        }

        const response = await fetch('/api/admin/operations/overview.json', {
          method: 'GET',
          headers: { Authorization: `Bearer ${accessToken}` },
        });
        const payload = await response.json().catch(() => null);

        if (response.status === 401) {
          showOnly(lockEl);
          return;
        }
        if (response.status === 403) {
          if (lockTitleEl) lockTitleEl.textContent = '접근 권한이 없습니다';
          if (lockCopyEl) lockCopyEl.textContent = '이 화면은 관리자만 볼 수 있습니다.';
          loginActionEl?.setAttribute('hidden', 'true');
          showOnly(lockEl);
          return;
        }
        if (!payload || !payload.ok || !response.ok) {
          // Preserve last-good data on a failed refresh; show a delayed/unavailable notice only.
          setStaleNotice('운영 정보를 새로 불러오지 못했습니다. 이전 데이터를 표시합니다.');
          if (lastGoodOverview) showOnly(bodyEl);
          return;
        }

        lastGoodOverview = payload.overview as AdminOperationsOverview;
        setStaleNotice(null);
        showOnly(bodyEl);
        renderOverview(lastGoodOverview);
      } catch {
        setStaleNotice('운영 정보를 새로 불러오지 못했습니다. 이전 데이터를 표시합니다.');
        if (lastGoodOverview) showOnly(bodyEl);
        else showOnly(lockEl);
      } finally {
        refreshInFlight = false;
        if (refreshBtn) refreshBtn.disabled = false;
      }
    };

    refreshBtn?.addEventListener('click', () => {
      void loadOverview();
    });

    if (!isSupabaseConfigured()) {
      showOnly(lockEl);
    } else {
      void loadOverview();
    }
  </script>
</Layout>
