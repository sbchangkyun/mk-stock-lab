---
import Layout from '../layouts/Layout.astro';

/**
 * Phase 4A: static Astro 404 handler. No provider/auth/data calls -- this must render
 * unconditionally even when every backend dependency (Supabase, KIS, GNews) is unavailable, and
 * Astro's static-route convention makes this file the real HTTP 404 response for any unmatched
 * path (verified via the dev/preview server, not just visually).
 */
---

<Layout title="페이지를 찾을 수 없습니다 | MK Stock Lab" activePath="/404">
  <section class="not-found-shell">
    <p class="eyebrow">404</p>
    <h1>페이지를 찾을 수 없습니다</h1>
    <p class="lead">요청하신 페이지가 없거나 주소가 변경되었습니다.</p>
    <div class="hero-actions">
      <a class="button-link" href="/">홈으로 이동</a>
      <a class="button-link secondary" href="/market">시장으로 이동</a>
    </div>
  </section>
</Layout>

<style>
  .not-found-shell {
    max-width: 560px;
    margin: 48px auto;
    padding: 36px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: var(--shadow);
    text-align: center;
  }

  .not-found-shell .hero-actions {
    justify-content: center;
  }

  @media (max-width: 480px) {
    .not-found-shell {
      margin: 24px auto;
      padding: 24px;
    }
  }
</style>
